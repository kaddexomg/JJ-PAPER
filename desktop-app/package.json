{
  "name": "jj-paper-desktop",
  "version": "2.0.0",
  "description": "Aplicativo de Escritorio Nativo JJ Paper - Compatible con Windows 7, 10 y 11",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win7-32": "electron-builder --win --ia32",
    "build:win7-64": "electron-builder --win --x64"
  },
  "keywords": [
    "jj-paper",
    "pos",
    "mixnet",
    "windows-7"
  ],
  "author": "JJ Paper C.A.",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.jjpaper.desktop",
    "productName": "JJ Paper Desktop",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../assets/img/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

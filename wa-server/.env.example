# Copia este archivo como .env y completa los valores.
# La service_role key vive SOLO en .env (PC local). Jamás en el frontend, ni en git, ni en este ejemplo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# --- Correo del CRM (OPCIONAL: respaldo global) ---
# Lo normal es que CADA usuario configure su Gmail desde el panel (⚙️ Mi correo),
# guardado en la tabla jjp_email_accounts. Estas variables son solo un respaldo
# para quien no tenga su cuenta puesta. Puedes dejarlas vacías.
# Contraseña de aplicación de Google (NO tu clave normal):
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
GMAIL_USER=
GMAIL_APP_PASS=
GMAIL_FROM=

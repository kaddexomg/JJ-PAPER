# Copia este archivo como .env y completa los valores.
# La service_role key vive SOLO en .env (PC local). Jamás en el frontend, ni en git, ni en este ejemplo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# --- Correo del CRM (opcional) ---
# Gmail SMTP con "contraseña de aplicación" (NO tu clave normal):
#   Google Account → Seguridad → Verificación en 2 pasos (activarla) → Contraseñas de aplicaciones
# Si dejas esto vacío, el envío de correos queda desactivado y el resto del server sigue igual.
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASS=xxxxxxxxxxxxxxxx
GMAIL_FROM=JJ Paper <tucorreo@gmail.com>

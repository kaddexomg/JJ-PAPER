# Copia este archivo como .env y completa los valores.
# La service_role key vive SOLO en .env (PC local). Jamás en el frontend, ni en git, ni en este ejemplo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# --- Correo del CRM (vinculación con Google, SIN contraseñas) ---
# Cada usuario vincula su Gmail desde el panel (⚙️ Mi correo → "Vincular con Google").
# El server usa las MISMAS credenciales OAuth del login con Google para enviar por
# la API de Gmail. Pega aquí el Client ID y Secret del OAuth client (el mismo del
# login): Google Cloud Console → APIs y servicios → Credenciales → tu OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Respaldo SMTP opcional (solo si algún día usas una cuenta con contraseña de app) ---
GMAIL_USER=
GMAIL_APP_PASS=
GMAIL_FROM=

# --- Carpeta de exportación de pedidos para el Mixer de Facturación ---
# Directorio local en la PC de la tienda donde se exportarán los archivos planos (TXT y CSV).
# Si se deja vacío, se exportará a la carpeta "mixer_export" en la raíz del proyecto.
MIXER_EXPORT_DIR=C:/JJ-PAPER-MIXER


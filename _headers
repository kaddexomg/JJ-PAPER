# diag.html comprueba con eval() qué soporta el navegador: es su razón de ser.
# Sin 'unsafe-eval' reportaria "no soportado" en TODO y enganaria el diagnostico.
# El permiso vive SOLO en esta pagina, no en el resto del sitio.
/diag.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://wwcdxqpibequfohbgejs.supabase.co wss://wwcdxqpibequfohbgejs.supabase.co https://klcibjwleiqppedefpxw.supabase.co wss://klcibjwleiqppedefpxw.supabase.co https://nmcamjxhyysmmvgxgabo.supabase.co wss://nmcamjxhyysmmvgxgabo.supabase.co; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Librerías con versión en el nombre: se pueden cachear para siempre.
# Esto es lo que hace que el panel abra rápido en las PCs viejas de la tienda.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Configuración crítica y autenticación: siempre frescos, sin caché obsoleta
/assets/js/config.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/js/admin/auth.js
  Cache-Control: no-cache, no-store, must-revalidate
